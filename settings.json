{
  "autocompleteMaxVisible": 5,
  "collapseChangelog": true,
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.84.1",
  "packages": [
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/elidickinson/pi-claude-bridge",
    "npm:@agnishc/edb-agent-steer",
    "npm:@aliou/pi-guardrails",
    "npm:@diegopetrucci/pi-quiet-tools",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-agent-loop",
    "npm:pi-execution-time",
    "npm:pi-mcp-adapter",
    "npm:pi-rewind",
    "npm:pi-subagents",
    "npm:pi-tool-display",
    "npm:pi-powerline"
  ],
  "theme": "catppuccin-mocha",
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "user-only",
  "skills": [
    "~/.config/agents/skills/pi"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low",
        "fallbackModels": [
          "claude-bridge/claude-sonnet-5"
        ]
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "claude-bridge/claude-fable-5"
        ]
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium",
        "fallbackModels": [
          "claude-bridge/claude-fable-5"
        ]
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "fallbackModels": [
          "claude-bridge/claude-sonnet-5"
        ]
      },
      "worker": {
        "model": "claude-bridge/claude-fable-5",
        "thinking": "high",
        "fallbackModels": [
          "claude-bridge/claude-sonnet-5"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "claude-bridge/claude-fable-5"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "xhigh",
        "fallbackModels": [
          "claude-bridge/claude-fable-5"
        ]
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium",
        "fallbackModels": [
          "claude-bridge/claude-sonnet-5"
        ]
      }
    }
  },
  "httpIdleTimeoutMs": 60000,
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "quietStartup": true,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "tuiMode": "regular",
  "fullscreenScrollbar": "auto"
}