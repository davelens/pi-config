{
  "autocompleteMaxVisible": 5,
  "collapseChangelog": true,
  "defaultModel": "claude-opus-4-8",
  "defaultProvider": "claude-bridge",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.80.3",
  "packages": [
    "git:github.com/elidickinson/pi-claude-bridge",
    "npm:pi-intercom",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-prompt-template-model",
    "npm:@quintinshaw/pi-dynamic-workflows"
  ],
  "theme": "catppuccin-mocha",
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "default",
  "skills": [
    "~/.config/agents/skills/pi"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "medium"
      },
      "planner": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "high"
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "medium"
      },
      "worker": {
        "model": "claude-bridge/claude-opus-4-8",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.5"
        ]
      },
      "reviewer": {
        "model": "claude-bridge/claude-opus-4-8",
        "thinking": "high"
      },
      "oracle": {
        "model": "claude-bridge/claude-opus-4-8",
        "thinking": "high"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "medium"
      }
    }
  }
}
