{
  "autocompleteMaxVisible": 5,
  "collapseChangelog": true,
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.82.1",
  "packages": [
    "git:github.com/elidickinson/pi-claude-bridge",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-prompt-template-model",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:@aliou/pi-guardrails",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "theme": "catppuccin-mocha",
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "default",
  "skills": [
    "~/.config/agents/skills/pi"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low",
        "fallbackModels": [
          "claude-bridge/claude-sonnet-5"
        ]
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "claude-bridge/claude-fable-5"
        ]
      },
      "context-builder": {
        "model": "claude-bridge/claude-fable-5",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra"
        ]
      },
      "researcher": {
        "model": "claude-bridge/claude-sonnet-5",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "claude-bridge/claude-sonnet-5"
        ]
      },
      "reviewer": {
        "model": "claude-bridge/claude-fable-5",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "oracle": {
        "model": "claude-bridge/claude-fable-5",
        "thinking": "xhigh",
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium",
        "fallbackModels": [
          "claude-bridge/claude-sonnet-5"
        ]
      }
    }
  }
}