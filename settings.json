{
  "autocompleteMaxVisible": 5,
  "collapseChangelog": true,
  "defaultModel": "gpt-5.5",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "medium",
  "editorPaddingX": 1,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.79.6",
  "packages": [
    "git:github.com/locus84/pi-claude-bridge",
    "npm:pi-intercom",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents"
  ],
  "theme": "catppuccin-mocha",
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "default",
  "skills": [
    "~/.config/agents/skills/pi"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "medium"
      },
      "planner": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "high"
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "medium"
      },
      "worker": {
        "model": "claude-bridge/claude-opus-4-7",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.5"
        ]
      },
      "reviewer": {
        "model": "claude-bridge/claude-opus-4-7",
        "thinking": "high"
      },
      "oracle": {
        "model": "claude-bridge/claude-opus-4-7",
        "thinking": "high"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "medium"
      }
    }
  }
}