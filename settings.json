{
  "autocompleteMaxVisible": 5,
  "collapseChangelog": true,
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.85.1",
  "packages": [
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/elidickinson/pi-claude-bridge",
    "npm:@agnishc/edb-agent-steer",
    "npm:@aliou/pi-guardrails",
    "npm:@diegopetrucci/pi-quiet-tools",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-agent-loop",
    "npm:pi-execution-time",
    "npm:pi-mcp-adapter",
    "npm:pi-rewind",
    "npm:pi-tool-display",
    "npm:pi-powerline",
    "./extensions/session-breadcrumb/index.ts"
  ],
  "theme": "catppuccin-mocha",
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "user-only",
  "skills": [
    "~/.config/agents/skills/pi"
  ],
  "subagents": {
    "aliases": {
      "architect": "planner",
      "coder": "worker",
      "developer": "worker"
    },
    "agentOverrides": {
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "xhigh"
      },
      "worker": {
        "timeoutMs": 2700000
      },
      "reviewer": {
        "model": "claude-bridge/claude-fable-5",
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol"
        ],
        "thinking": "high"
      }
    }
  },
  "httpIdleTimeoutMs": 60000,
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "quietStartup": true,
  "defaultProjectTrust": "ask",
  "doubleEscapeAction": "tree",
  "tuiMode": "regular",
  "fullscreenScrollbar": "auto"
}